if(RADAR_ENABLE_CAMERA)
    find_package(OpenCV 4.5 REQUIRED COMPONENTS core imgproc imgcodecs dnn)
    add_library(radar_camera_association STATIC src/vision/camera_association.cpp)
    target_include_directories(radar_camera_association PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src/vision ${OpenCV_INCLUDE_DIRS})
    target_link_libraries(radar_camera_association PUBLIC ${OpenCV_LIBS} radar_common)
    if(BUILD_TESTING)
        add_executable(camera_association_test tests/vision/camera_association_test.cpp)
        target_link_libraries(camera_association_test PRIVATE radar_camera_association)
        add_test(NAME camera_association COMMAND camera_association_test)
    endif()
endif()
if(RADAR_ENABLE_CUDA)
    if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
        set(CMAKE_CUDA_ARCHITECTURES 87 CACHE STRING "CUDA architecture")
    endif()
    enable_language(CUDA)
    set(CMAKE_CUDA_STANDARD 17)
    find_package(CUDAToolkit REQUIRED)
endif()
add_library(radar_tracking_core STATIC src/tracking/target_tracking.cpp src/tracking/trajectory_association.cpp)
