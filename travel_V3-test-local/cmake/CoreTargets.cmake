target_include_directories(radar_odom_replay PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src/replay)
target_link_libraries(radar_odom_replay PUBLIC radar_common)
add_library(radar_dsp STATIC src/radar/dsp/fft.cpp src/radar/dsp/CFAR.cpp src/radar/dsp/DoA.cpp src/radar/dsp/signal_processing.cpp src/radar/device/iwr6843param.cpp)
target_include_directories(radar_dsp PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src/radar/dsp)
