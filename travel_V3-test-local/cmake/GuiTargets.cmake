if(BUILD_RADAR_APP)
    if(NOT UNIX)
        message(FATAL_ERROR "The GUI requires Linux; on Windows use WSL2 with WSLg.")
    endif()
    find_package(Qt5 5.12 REQUIRED COMPONENTS Core Gui Widgets Network)
    add_library(radar_gui_core STATIC src/ui/radar_gui.cpp src/ui/radar_gui.hpp
        src/radar/device/radar_config.cpp src/radar/capture/realtime_capture.cpp src/ui/widgets/cluster.cpp src/ui/widgets/cluster.hpp
        src/ui/ros_runtime_panel.cpp src/ui/ros_runtime_panel.hpp src/ui/cooperative_view.cpp src/ui/cooperative_view.hpp)
    target_sources(radar_gui_core PRIVATE src/ui/cooperative_workspace.cpp src/ui/forms/radar_gui_v2.ui)
    target_include_directories(radar_gui_core PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src/ui ${CMAKE_CURRENT_SOURCE_DIR}/src/ui/widgets ${CMAKE_CURRENT_SOURCE_DIR}/src/ui/replay ${CMAKE_CURRENT_SOURCE_DIR}/src/radar/capture ${CMAKE_CURRENT_SOURCE_DIR}/src/app)
    target_include_directories(radar_gui_core PUBLIC ${CMAKE_CURRENT_BINARY_DIR}/radar_gui_core_autogen/include)
    set_target_properties(radar_gui_core PROPERTIES AUTOMOC ON AUTOUIC ON AUTOUIC_SEARCH_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/src/ui/forms")
    target_link_libraries(radar_gui_core PUBLIC radar_dsp radar_tracking_core radar_odom_replay
        Qt5::Core Qt5::Gui Qt5::Widgets Qt5::Network Threads::Threads)
    target_compile_definitions(radar_gui_core PUBLIC RADAR_ENABLE_CAMERA=$<BOOL:${RADAR_ENABLE_CAMERA}>)
    if(RADAR_ENABLE_CAMERA)
        target_sources(radar_gui_core PRIVATE src/vision/camera_worker.cpp src/vision/camera_recording.cpp src/ui/replay/camera_replay.cpp src/ui/camera_assist_panel.cpp src/ui/camera_assist_panel.hpp)
        target_link_libraries(radar_gui_core PUBLIC radar_camera_association)
        add_executable(camera_probe tools/diagnostics/camera_probe.cpp)
        target_link_libraries(camera_probe PRIVATE radar_gui_core)
        if(BUILD_TESTING)
            add_executable(camera_bridge_test tests/vision/camera_bridge_test.cpp)
            target_link_libraries(camera_bridge_test PRIVATE radar_gui_core)
            add_test(NAME camera_bridge COMMAND camera_bridge_test)
            set_tests_properties(camera_bridge PROPERTIES TIMEOUT 25)
            if(Python3_Interpreter_FOUND)
                add_test(NAME windows_camera_bridge COMMAND ${Python3_EXECUTABLE} -B
                    ${CMAKE_CURRENT_SOURCE_DIR}/tests/vision/test_windows_camera_bridge.py)
                set_tests_properties(windows_camera_bridge PROPERTIES TIMEOUT 10)
            endif()
            add_executable(camera_recording_test tests/vision/camera_recording_test.cpp src/vision/camera_recording.cpp)
            target_include_directories(camera_recording_test PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src/vision ${OpenCV_INCLUDE_DIRS})
            target_link_libraries(camera_recording_test PRIVATE Qt5::Core Qt5::Gui ${OpenCV_LIBS} Threads::Threads)
            target_link_libraries(camera_recording_test PRIVATE radar_common)
    add_test(NAME camera_recording COMMAND camera_recording_test)
            add_executable(camera_replay_test tests/vision/camera_replay_test.cpp)
            target_link_libraries(camera_replay_test PRIVATE radar_gui_core)
            add_test(NAME camera_replay COMMAND camera_replay_test)
            set_tests_properties(camera_replay PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 10)
            add_executable(camera_panel_test tests/vision/camera_panel_test.cpp)
            target_link_libraries(camera_panel_test PRIVATE radar_gui_core)
            add_test(NAME camera_panel COMMAND camera_panel_test)
            set_tests_properties(camera_panel PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 20)
        endif()
    endif()
    add_executable(radar_gui src/app/main_gui.cpp)
    target_link_libraries(radar_gui PRIVATE radar_gui_core)
    if(BUILD_TESTING)
        target_compile_definitions(radar_gui_core PUBLIC RADAR_GUI_ENABLE_TEST_ACCESS)
        add_executable(indoor_selection_test tests/ui/indoor_selection_test.cpp)
        target_link_libraries(indoor_selection_test PRIVATE radar_gui_core)
        add_test(NAME indoor_selection COMMAND indoor_selection_test)
        set_tests_properties(indoor_selection PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 20)
        add_executable(cooperative_preview tests/ui/cooperative_preview.cpp src/ui/cooperative_view.cpp)
        target_include_directories(cooperative_preview PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src/ui)
        target_link_libraries(cooperative_preview PRIVATE Qt5::Widgets)
        if(RADAR_ENABLE_CAMERA)
            add_executable(cooperative_layout_test tests/ui/cooperative_layout_test.cpp)
            target_link_libraries(cooperative_layout_test PRIVATE radar_gui_core)
            add_test(NAME cooperative_layout COMMAND cooperative_layout_test)
            set_tests_properties(cooperative_layout PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 20)
        endif()
        add_executable(ros_runtime_panel_test tests/ros/ros_runtime_panel_test.cpp)
        target_link_libraries(ros_runtime_panel_test PRIVATE radar_gui_core)
        add_test(NAME ros_runtime_panel COMMAND ros_runtime_panel_test ${CMAKE_CURRENT_SOURCE_DIR}/tests/ros/fake_gui_runtime.py)
        set_tests_properties(ros_runtime_panel PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 40)
        add_executable(gui_transport_test tests/ui/gui_transport_test.cpp)
        target_link_libraries(gui_transport_test PRIVATE radar_gui_core)
        add_test(NAME gui_transport COMMAND gui_transport_test ${CMAKE_CURRENT_SOURCE_DIR}/config/radar/IWR6843_260714-15m-10Hz-9.8cm.cfg)
        set_tests_properties(gui_transport PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 20)
        add_executable(gui_lifecycle_test tests/ui/gui_lifecycle_test.cpp)
        target_link_libraries(gui_lifecycle_test PRIVATE radar_gui_core)
        add_test(NAME gui_lifecycle COMMAND gui_lifecycle_test)
        set_tests_properties(gui_lifecycle PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 20)
    endif()
endif()
